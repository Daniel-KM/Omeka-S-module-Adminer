From abeaa4a444e920c46316fcb2810322300fa25e49 Mon Sep 17 00:00:00 2001
From: Daniel Berthereau <Daniel.git@Berthereau.net>
Date: Mon, 10 Aug 2026 17:29:26 +0000
Subject: [PATCH] Designs: Show only the icon of the edit link in select
---
 designs/hever/adminer.css            | 2 +-
 designs/konya/adminer.css            | 2 +-
 designs/price/adminer.css            | 2 +-
 designs/rmsoft/adminer.css           | 4 ++--
 designs/rmsoft_blue-dark/adminer.css | 4 ++--
 designs/rmsoft_blue/adminer.css      | 4 ++--
 6 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/designs/hever/adminer.css b/designs/hever/adminer.css
index 0e45a2c7..b6b2e249 100644
--- a/designs/hever/adminer.css
+++ b/designs/hever/adminer.css
@@ -55,7 +55,7 @@ th a[href*="&table="]  {background:url("data:image/png;base64,iVBORw0KGgoAAAANSU
 
 table tbody input[name*="check"] {display:block; float:left;}
 
-table a[href*="&edit="][href*="&where"] {background:url("data:image/png;base64,") no-repeat scroll right bottom; padding-right:18px;}
+table a[href*="&edit="][href*="&where"] {background:url("data:image/png;base64,") no-repeat scroll right bottom;}
 
 table a.edit {width:0; float:left; display:block; height:16px; overflow:hidden; text-decoration:none; padding:0 0 0 18px; background-position:2px bottom;}
 
diff --git a/designs/konya/adminer.css b/designs/konya/adminer.css
index 23697e13..5d97cba1 100644
--- a/designs/konya/adminer.css
+++ b/designs/konya/adminer.css
@@ -48,7 +48,7 @@ html/*\*/>/*/*/body #content p a[href*="&sql="] {background:url("data:image/png;
 
 html/*\*/>/*/*/body table tbody input[name*="check"] {display:block; float:left;}
 
-html/*\*/>/*/*/body table a[href*="&edit="][href*="&where"] {background:url("data:image/png;base64,") no-repeat scroll right bottom; padding-right:18px;}
+html/*\*/>/*/*/body table a[href*="&edit="][href*="&where"] {background:url("data:image/png;base64,") no-repeat scroll right bottom;}
 
 html/*\*/>/*/*/body table a.edit {width:0; float:left; display:block; height:16px; overflow:hidden; text-decoration:none; padding:0 0 0 18px; background-position:2px bottom; margin-left:5px;}
 html/*\*/>/*/*/body table tbody td:first-child {white-space:normal;}
diff --git a/designs/price/adminer.css b/designs/price/adminer.css
index 278a4c14..eda74c57 100644
--- a/designs/price/adminer.css
+++ b/designs/price/adminer.css
@@ -43,7 +43,7 @@ html/*\*/>/*/*/body #content p a[href*="&schema="] {background:url("data:image/p
 html/*\*/>/*/*/body #content p a[href*="&tbsdesc="] {background:url("data:image/png;base64,") no-repeat scroll 2px bottom; padding-left:22px;}
 html/*\*/>/*/*/body #content p a[href*="&sql="] {background:url("data:image/png;base64,") no-repeat scroll 2px bottom; padding-left:24px;}
 html/*\*/>/*/*/body table tbody input[name*="check"] {display:block; float:left;}
-html/*\*/>/*/*/body table a[href*="&edit="][href*="&where"] {background:url("data:image/png;base64,") no-repeat scroll right bottom; padding-right:18px;}
+html/*\*/>/*/*/body table a[href*="&edit="][href*="&where"] {background:url("data:image/png;base64,") no-repeat scroll right bottom;}
 html/*\*/>/*/*/body table a.edit {width:0; float:left; display:block; height:16px; overflow:hidden; text-decoration:none; padding:0 0 0 18px; background-position:2px bottom; margin-left:5px;}
 html/*\*/>/*/*/body table tbody td:first-child {white-space:normal;}
 html/*\*/>/*/*/body table thead input {margin-right: 5px;}
diff --git a/designs/rmsoft/adminer.css b/designs/rmsoft/adminer.css
index 4ddc53db..8d42d3d0 100644
--- a/designs/rmsoft/adminer.css
+++ b/designs/rmsoft/adminer.css
@@ -285,8 +285,8 @@ table thead #all-page~a{background:url("data:image/png;base64,iVBORw0KGgoAAAANSU
 table a[href*="&edit="][href*="&where"],#fieldset-history a[href*="&sql=&history"]:not([href*="&sql=&history=all"]){background:url("data:image/png;base64,") no-repeat scroll right bottom;display:inline-block;overflow:hidden}
 .ltr table a[href*="&edit="][href*="&where"]{background-position:right;padding:0 20px 0 8px}
 .rtl table a[href*="&edit="][href*="&where"]{background-position:left;padding:0 8px 0 20px}
-.ltr table input[type=checkbox]~a[href*="&edit="][href*="&where"],.ltr #fieldset-history a[href*="&sql=&history"]:not([href*="&sql=&history=all"]){height:14px;width:0;text-decoration:none;padding:0 0 0 16px}
-.rtl table input[type=checkbox]~a[href*="&edit="][href*="&where"],.rtl #fieldset-history a[href*="&sql=&history"]:not([href*="&sql=&history=all"]){background-position:left;height:14px;width:0;text-decoration:none;padding:0 16px 0 0}
+.ltr table a.edit[href*="&where"],.ltr #fieldset-history a[href*="&sql=&history"]:not([href*="&sql=&history=all"]){height:14px;width:0;text-decoration:none;padding:0 0 0 16px}
+.rtl table a.edit[href*="&where"],.rtl #fieldset-history a[href*="&sql=&history"]:not([href*="&sql=&history=all"]){background-position:left;height:14px;width:0;text-decoration:none;padding:0 16px 0 0}
 #menu #dbs span{background:url("data:image/png;base64,") no-repeat scroll left bottom}
 .ltr #menu #dbs span{padding-left:22px}
 .rtl #menu #dbs span{background-position:right;padding:0 20px 0 0}

From 09af5b6d3a3726d009a6125e28e0ba45c39b998c Mon Sep 17 00:00:00 2001
From: Daniel Berthereau <Daniel.git@Berthereau.net>
Date: Mon, 10 Aug 2026 00:00:00 +0000
Subject: [PATCH] Designs: Show the table names in the menu of Editor

---
 designs/hever/adminer.css            | 2 +-
 designs/konya/adminer.css            | 2 +-
 designs/rmsoft/adminer.css           | 6 +++---
 designs/rmsoft_blue-dark/adminer.css | 6 +++---
 designs/rmsoft_blue/adminer.css      | 6 +++---
 5 files changed, 11 insertions(+), 11 deletions(-)

diff --git a/designs/hever/adminer.css b/designs/hever/adminer.css
index 97a804a5..0e45a2c7 100644
--- a/designs/hever/adminer.css
+++ b/designs/hever/adminer.css
@@ -28,7 +28,7 @@ a[href$="&import="] {background:url("data:image/png;base64,iVBORw0KGgoAAAANSUhEU
   #menu .links a:hover {color:red;}
 }
 
-#menu ul#tables a[href*="&select="] {background:url("data:image/png;base64,") no-repeat scroll right bottom; display:inline-block; height:16px; margin-right:4px; vertical-align:middle; overflow:hidden; padding-left:16px; width:0;}
+body.adminer #menu ul#tables a[href*="&select="] {background:url("data:image/png;base64,") no-repeat scroll right bottom; display:inline-block; height:16px; margin-right:4px; vertical-align:middle; overflow:hidden; padding-left:16px; width:0;}
 #menu ul#tables a.active[href*="&select="] {border-left:2px solid #00f; margin-left:-4px; padding-left:18px;}
 
 .links a[href*="&create="] {background:url("data:image/png;base64,") no-repeat scroll 2px bottom; padding-left:22px;}
diff --git a/designs/konya/adminer.css b/designs/konya/adminer.css
index e350d76b..23697e13 100644
--- a/designs/konya/adminer.css
+++ b/designs/konya/adminer.css
@@ -24,7 +24,7 @@ html/*\*/>/*/*/body a[href$="dump="] {background:url("data:image/png;base64,iVBO
 html/*\*/>/*/*/body select[name="db"] {background:white url("data:image/png;base64,") no-repeat scroll left bottom; padding-left:16px;}
 html/*\*/>/*/*/body select[name="db"] option {padding-left:18px;}
 
-html/*\*/>/*/*/body #menu li a[href*="&select="] {background:url("data:image/png;base64,") no-repeat scroll left bottom; clear:left; display:block; float:left; height:16px; margin-right:8px; padding-top:1px; overflow:hidden; padding-left:16px; width:0; text-decoration:none;}
+html/*\*/>/*/*/body.adminer #menu li a[href*="&select="] {background:url("data:image/png;base64,") no-repeat scroll left bottom; clear:left; display:block; float:left; height:16px; margin-right:8px; padding-top:1px; overflow:hidden; padding-left:16px; width:0; text-decoration:none;}
 
 html/*\*/>/*/*/body #menu li a[href*="&table="], html/*\*/>/*/*/body #menu li a[href*="&view="] {clear:right; margin-left:24px; display:block; height:17px; padding-bottom:1px; text-decoration:none;}
 
diff --git a/designs/rmsoft/adminer.css b/designs/rmsoft/adminer.css
index def53a6f..4ddc53db 100644
--- a/designs/rmsoft/adminer.css
+++ b/designs/rmsoft/adminer.css
@@ -273,9 +273,9 @@ input[type=submit]{border:thin solid #000;border-radius:3px}
 input[type=submit]:enabled{cursor:pointer}
 input[type=submit]:disabled{cursor:not-allowed;border-color:#666}
 input[type=submit]:enabled:hover{background-color:#ffe0c2}
-#menu li a[href*="&select="]{background:url("data:image/png;base64,") no-repeat scroll bottom;height:12px;width:0;display:block;overflow:hidden;text-decoration:none}
-.ltr #menu li a[href*="&select="]{background-position:right;clear:left;float:left;margin:0 8px 0 0;padding:1px 0 0 20px}
-.rtl #menu li a[href*="&select="]{background-position:left;clear:right;float:right;margin:0 0 0 8px;padding:1px 20px 0 0}
+body.adminer #menu li a[href*="&select="]{background:url("data:image/png;base64,") no-repeat scroll bottom;height:12px;width:0;display:block;overflow:hidden;text-decoration:none}
+.ltr body.adminer #menu li a[href*="&select="]{background-position:right;clear:left;float:left;margin:0 8px 0 0;padding:1px 0 0 20px}
+.rtl body.adminer #menu li a[href*="&select="]{background-position:left;clear:right;float:right;margin:0 0 0 8px;padding:1px 20px 0 0}
 table thead #all-page~a{background:url("data:image/png;base64,") no-repeat scroll bottom;height:16px;width:0;display:inline-block;overflow:hidden;text-decoration:none;margin:0 0 -4px 0}
 .ltr table thead #all-page~a{background-position:right;padding:0 0 0 18px}
 .rtl table thead #all-page~a{background-position:left;padding:0 18px 0 0}
